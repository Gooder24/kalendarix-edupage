# Copy to .env (cp .env.example .env && chmod 600 .env) and fill in. Never commit .env.

# --- EduPage ---
# Your school's subdomain: https://<SUBDOMAIN>.edupage.org
EDUPAGE_SUBDOMAIN=
EDUPAGE_USERNAME=
EDUPAGE_PASSWORD=

# --- Server ---
# Address to listen on. Keep it private: localhost, or a VPN address such as Tailscale's
# when the calendar runs on another machine.
KX_HOST=127.0.0.1
KX_PORT=8787
# Optional. When set, the API and the ICS feed need
# "Authorization: Bearer <token>" or "?token=<token>".
KX_TOKEN=

# --- Sync ---
KX_SYNC_INTERVAL_MIN=30
KX_SYNC_DAYS_AHEAD=14
KX_TIMEZONE=Europe/Bratislava
